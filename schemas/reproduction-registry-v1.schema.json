{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyouo/impact_of_guided_questioning_on_llm_bias/schemas/reproduction-registry-v1.schema.json",
  "title": "LLM Theory Lab Transformer Circuits reproduction registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_kind",
    "snapshot_date",
    "catalog_path",
    "catalog_sha256",
    "audit_note",
    "coverage_status_definitions",
    "mode_definitions",
    "protocols",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_kind": {
      "const": "transformer-circuits-reproduction-map"
    },
    "snapshot_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "catalog_path": {
      "type": "string",
      "minLength": 1
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audit_note": {
      "type": "string",
      "minLength": 1
    },
    "coverage_status_definitions": {
      "type": "object",
      "required": [
        "implemented-complete",
        "implemented-partial",
        "planned",
        "reference-only"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "mode_definitions": {
      "type": "object",
      "required": [
        "exact-reproduction",
        "open-model-analogue",
        "transparent-proxy",
        "reference"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocols": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "maturity",
          "runner",
          "evidence_ceiling",
          "default_ci",
          "requires"
        ],
        "properties": {
          "kind": {
            "enum": [
              "exact-reproduction",
              "open-model-analogue",
              "transparent-proxy"
            ]
          },
          "maturity": {
            "enum": [
              "validated",
              "prototype",
              "planned"
            ]
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ceiling": {
            "type": "string",
            "minLength": 1
          },
          "default_ci": {
            "type": "boolean"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "period",
          "title",
          "url",
          "source_type",
          "theme",
          "catalog_role",
          "coverage_status",
          "current_modes",
          "protocol_ids",
          "exact_reproduction_feasibility",
          "target_mode",
          "priority",
          "compute_tier",
          "blockers",
          "acceptance_criteria",
          "next_step"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^TC-[0-9A-F]{10}$"
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "catalog_role": {
            "type": "string",
            "minLength": 1
          },
          "coverage_status": {
            "enum": [
              "implemented-complete",
              "implemented-partial",
              "planned",
              "reference-only"
            ]
          },
          "current_modes": {
            "type": "array",
            "items": {
              "enum": [
                "exact-reproduction",
                "open-model-analogue",
                "transparent-proxy",
                "reference"
              ]
            },
            "uniqueItems": true
          },
          "protocol_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[CM][0-9]{2}$"
            },
            "uniqueItems": true
          },
          "exact_reproduction_feasibility": {
            "enum": [
              "public-protocol-likely-feasible",
              "blocked-by-proprietary-or-unpublished-assets",
              "source-specific-audit-required",
              "not-applicable"
            ]
          },
          "target_mode": {
            "enum": [
              "exact-or-close-reproduction",
              "open-model-analogue",
              "source-audit-then-decide",
              "reference-only"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "compute_tier": {
            "enum": [
              "none",
              "cpu",
              "single-gpu",
              "multi-gpu",
              "unknown"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "acceptance_criteria": {
            "type": "string",
            "minLength": 1
          },
          "next_step": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
